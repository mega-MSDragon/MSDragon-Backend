// =====================================================================
// 모셔용(MoSheoYong) ERD - dbdiagram.io 용 DBML
// Figma 와이어프레임 반영본
// - 로그인 provider는 iOS/Android 와이어프레임 기준으로 kakao/apple만 유지
// - 가족은 자녀 1명, 부모 최대 2명을 앱 검증과 DB trigger로 강제
// - 10계명은 서버 후보군에서 랜덤 제공 후 여행별 확정본으로 복사
// - 효도 리포트는 고정 지표와 기록 화면용 집계값을 저장
// - 동의/알림/위치 권한 설정은 앱 로컬/OS 권한으로 관리하고 백엔드 ERD에서 제외
// =====================================================================

// ---------- Enums ----------
Enum user_role {
  child
  parent
}

Enum oauth_provider {
  kakao
  apple
}

Enum age_band {
  "10s"
  "20s"
  "30s"
  "40s"
  "50s"
  "60s"
  "60s_plus"
  "70s"
  "80s"
  "90s_plus"
  undisclosed
}

Enum gender_type {
  female
  male
  undisclosed
}

Enum device_platform {
  ios
  android
  web
}

Enum parent_profile_status {
  draft
  completed
}

Enum walking_pace {
  slow
  normal
  fast
}

Enum travel_destination_code {
  daegu
  gangneung_sokcho
  gyeongju
  busan
  yeosu
  incheon
  jeonju
  jeju
  seoul
  suwon_yongin
  tongyeong_geoje_namhae
  pohang_andong
}

Enum travel_theme_code {
  nature_scenery
  history_culture
  shopping
  activity
  culture_life
  landmark
  experience
}

Enum food_preference_code {
  korean
  familiar
  adventurous
}

Enum trip_status {
  planning
  ready
  in_progress
  completed
  archived
}

Enum trip_pledge_status {
  draft
  reviewed
  signature_requested
  completed
}

Enum trip_companion_scope {
  with_parents
  whole_family
  parents_only
}

Enum stop_type {
  sightseeing
  meal
  rest
  cafe
}

Enum course_generation_status {
  pending
  collecting_data
  routing
  generating
  completed
  failed
}

Enum external_api_provider {
  tour_api
  tmap
  kakao_map
  public_data
  local_excel
  internal
}

Enum support_facility_type {
  restroom
  hospital
  pharmacy
}

Enum chat_session_scope {
  travel_mode
  place_detail
  general
}

Enum chat_sender {
  user
  assistant
}

Enum feedback_body_condition {
  comfortable
  slightly_tired
  very_tired
}

Enum report_stop_badge {
  comfortable
  caution
}

Enum feedback_tag {
  route_comfortable
  food_good
  slightly_tired
  next_slower
}

// ---------- 1. 식별 · 인증 · 가족 ----------
Table users {
  id bigint [pk, increment]
  role user_role [not null]
  oauth_provider oauth_provider [not null]
  oauth_subject varchar(255) [not null]
  display_name varchar(50) [not null]
  age_band age_band [not null, default: 'undisclosed']
  gender gender_type [not null, default: 'undisclosed']
  signup_completed_at datetime
  last_login_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
  deleted_at datetime

  indexes {
    (oauth_provider, oauth_subject) [unique]
  }

  Note: '마이페이지 기본 프로필. 이름, 연령대, 성별 수정은 users를 갱신한다. 연결 가족의 기본 프로필 수정 가능 여부는 family_members 관계와 서비스 권한으로 검증한다.'
}

Table user_refresh_tokens {
  id bigint [pk, increment]
  user_id bigint [not null]
  refresh_token_hash varchar(255) [not null, unique]
  platform device_platform
  issued_at datetime [not null, default: `now()`]
  expires_at datetime [not null]
  last_used_at datetime
  revoked_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    user_id
    expires_at
  }
}

Table families {
  id bigint [pk, increment]
  owner_user_id bigint [not null]
  is_active boolean [not null, default: true]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table family_members {
  id bigint [pk, increment]
  family_id bigint [not null]
  user_id bigint [not null, unique, note: '1유저 1가족']
  member_role user_role [not null]
  relation_label varchar(20) [note: '현재 API에서는 입력받지 않으며, 응답 relationLabel은 부모 users.gender 기준으로 계산한다.']
  joined_at datetime [not null, default: `now()`]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: '가족당 자녀 1명, 부모 최대 2명은 앱 검증과 DB trigger로 함께 강제한다. 엄마/아빠 표시는 부모 성별 기반 응답 계산값이다.'
}

Table family_codes {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  code varchar(20) [not null, unique]
  is_active boolean [not null, default: true]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: '회원가입 후 가족 매칭 전에도 발급되는 사용자별 고정 코드. child/parent 모두 코드를 가질 수 있다. code는 충돌 없이 생성해야 한다.'
}

Table family_code_usages {
  id bigint [pk, increment]
  family_code_id bigint [not null]
  requester_user_id bigint [not null, note: '상대방 코드를 입력한 사용자']
  family_id bigint [not null]
  matched_at datetime [not null, default: `now()`]

  indexes {
    (family_code_id, requester_user_id) [unique]
    family_id
  }
}

// ---------- 2. 부모 프로필 · 개인화 ----------
Table parent_profiles {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  status parent_profile_status [not null, default: 'draft']
  current_step smallint [not null, default: 1]
  walking_pace walking_pace
  needs_mobility_assistance boolean
  food_preference food_preference_code
  completion_percent smallint [not null, default: 0]
  completed_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: '부모 프로필은 확정 정책 기준으로 걷는 속도, 이동 도움 필요 여부, 여행 취향, 음식 취향을 단계별 draft 저장한다. 완료 시 walking_pace, needs_mobility_assistance, travelThemes 최소 1개, food_preference를 필수 검증한다. MBTI 현재값은 parent_personality_results.is_current로 조회한다.'
}

Table parent_profile_themes {
  parent_profile_id bigint [not null]
  theme_code travel_theme_code [not null]

  indexes {
    (parent_profile_id, theme_code) [unique]
  }

  Note: '정책 확정값: 자연·풍경, 역사·문화, 쇼핑, 액티비티, 문화생활, 랜드마크, 체험. 여행 테마 선택은 최소 1개, 최대 3개까지 서비스 레이어에서 검증한다.'
}

Table travel_personality_types {
  id bigint [pk, increment]
  type_code varchar(40) [not null, unique]
  name varchar(40) [not null]
  description text
  recommendation_principle text
  character_image_url varchar(500)
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table parent_personality_results {
  id bigint [pk, increment]
  parent_profile_id bigint [not null]
  travel_personality_type_id bigint [not null]
  is_current boolean [not null, default: true]
  profile_snapshot jsonb
  completed_at datetime [not null, default: `now()`]
  created_at datetime [not null, default: `now()`]

  indexes {
    (parent_profile_id, is_current) [note: '현재 결과 1개 제한은 실제 DB에서 is_current=true partial unique로 강제']
  }

  Note: 'MBTI 상세/재진단 이력. PDF 예시는 CARE/배려형 플래너이며, 최종 타입 목록은 seed data로 관리한다. 새로 MBTI 뽑기는 부모 프로필 작성 플로우를 다시 진행하고, 완료 시 기존 current를 false로 바꾼 뒤 새 결과를 current로 저장한다. profile_snapshot에는 진단 당시 프로필 입력값을 보관한다.'
}

Table parent_personality_scores {
  id bigint [pk, increment]
  result_id bigint [not null]
  metric_code varchar(40) [not null]
  score smallint [not null]

  indexes {
    (result_id, metric_code) [unique]
  }
}

// ---------- 3. 장소 · 접근성 ----------
Table regions {
  id bigint [pk, increment]
  area_code varchar(10) [unique]
  sido varchar(30) [not null]
  sigungu varchar(40)
  name varchar(60) [not null]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table travel_destinations {
  id bigint [pk, increment]
  name varchar(60) [not null]
  display_order smallint [not null, default: 0]
  badge_label varchar(20)
  is_active boolean [not null, default: true]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: '후속 DB 마스터 후보. MVP 구현은 TripDestinationCode enum catalog를 서버에서 내려주고 trips.destination_code에 저장한다.'
}

Table travel_destination_regions {
  id bigint [pk, increment]
  travel_destination_id bigint [not null]
  region_id bigint [not null]
  created_at datetime [not null, default: `now()`]

  indexes {
    (travel_destination_id, region_id) [unique]
  }
}

Table places {
  id bigint [pk, increment]
  tour_api_content_id varchar(20) [unique]
  content_type_id varchar(10)
  region_id bigint
  name varchar(120) [not null]
  category varchar(40)
  address varchar(255)
  latitude decimal(10,7)
  longitude decimal(10,7)
  phone varchar(30)
  homepage_url varchar(500)
  image_url varchar(500)
  operating_hours varchar(255)
  admission_fee varchar(100)
  overview text
  raw_detail jsonb
  detail_synced_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: '관광지 상세 화면은 TourAPI 기본/상세/반복정보를 기반으로 한다. 주소, 카테고리, 홈페이지, 전화, 이미지, 운영시간, 입장료, overview는 정규 컬럼으로 두고 그 외 유동 필드는 raw_detail에 보관한다.'
}

Table place_external_refs {
  id bigint [pk, increment]
  place_id bigint [not null]
  provider external_api_provider [not null]
  external_id varchar(100) [not null]
  last_synced_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (provider, external_id) [unique]
    (place_id, provider) [unique]
  }
}

Table place_relations {
  id bigint [pk, increment]
  source_place_id bigint [not null]
  related_place_id bigint [not null]
  provider external_api_provider [not null, default: 'tour_api']
  relation_type varchar(40) [not null, default: 'related']
  score decimal(6,3)
  raw_relation jsonb
  last_synced_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (source_place_id, related_place_id, provider, relation_type) [unique]
    related_place_id
  }

  Note: '관광지별 연관관광지 API 결과를 캐시한다. 검색/추천 화면의 카테고리 영역은 API 결과를 우선 사용하고, 선택 후 CTA 시 trip_stops에 추가한다.'
}

Table place_images {
  id bigint [pk, increment]
  place_id bigint [not null]
  image_url varchar(500) [not null]
  sort_order smallint [not null, default: 1]
  created_at datetime [not null, default: `now()`]

  indexes {
    (place_id, sort_order) [unique]
  }
}

Table place_accessibility {
  id bigint [pk, increment]
  place_id bigint [not null, unique]
  raw_accessibility jsonb
  has_stairs boolean
  has_slope boolean
  is_indoor boolean
  has_elevator boolean
  has_seating boolean
  wheelchair_accessible boolean
  restroom_distance_m int
  accessibility_score smallint
  source_provider external_api_provider [not null, default: 'tour_api']
  last_synced_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'TourAPI 무장애 응답은 parking, route, exit, elevator, restroom 등 string 원문을 raw_accessibility에 저장한다. 추천용 boolean은 원문 문자열의 빈값 여부와 키워드 파싱으로 산출한다.'
}

Table support_facilities {
  id bigint [pk, increment]
  facility_type support_facility_type [not null]
  provider external_api_provider [not null]
  source_id varchar(120) [not null]
  name varchar(120) [not null]
  address varchar(255)
  latitude decimal(10,7) [not null]
  longitude decimal(10,7) [not null]
  phone varchar(30)
  operating_hours varchar(255)
  raw_data jsonb
  last_synced_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (facility_type, provider, source_id) [unique]
    (facility_type, latitude, longitude)
  }

  Note: '여행모드 주변 안내용 보조시설. 화장실은 엑셀 원천을 local_excel provider로 적재하고, 병원/약국은 공공데이터 또는 지도 API 결과를 같은 구조로 캐시한다.'
}

// ---------- 4. 여행 · 일정 ----------
Table trips {
  id bigint [pk, increment]
  family_id bigint [not null]
  created_by_user_id bigint [not null]
  destination_code travel_destination_code [not null, note: 'PDF 확정 기준으로 여행 정보 편집 시 변경 가능. 변경 저장 후 코스 재추천 필요']
  title varchar(80) [not null]
  start_date date [not null]
  end_date date [not null]
  status trip_status [not null, default: 'planning']
  companion_scope trip_companion_scope [not null, default: 'with_parents']
  recommendation_snapshot jsonb
  comfort_score smallint
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
  deleted_at datetime

  Note: 'PDF 확정 기준으로 여행 도시는 여행 정보 편집에서 변경 가능하다. 도시, 날짜, 함께 가는 가족, 추천 기준을 바꾸면 저장 후 코스 재추천/덮어쓰기 확인 플로우를 거친다. 여행 기간 상한은 두지 않으며 여행모드는 start_date 00:00부터 end_date 23:59까지 노출한다.'
}

Table trip_participants {
  id bigint [pk, increment]
  trip_id bigint [not null]
  user_id bigint [not null]
  created_at datetime [not null, default: `now()`]

  indexes {
    (trip_id, user_id) [unique]
  }
}

Table course_generation_jobs {
  id bigint [pk, increment]
  family_id bigint [not null]
  requested_by_user_id bigint [not null]
  destination_code travel_destination_code [not null]
  trip_id bigint [unique]
  start_date date [not null]
  end_date date [not null]
  companion_scope trip_companion_scope [not null, default: 'with_parents']
  status course_generation_status [not null, default: 'pending']
  progress_percent smallint [not null, default: 0]
  input_snapshot jsonb
  failure_reason varchar(500)
  started_at datetime
  completed_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (family_id, status)
    requested_by_user_id
  }

  Note: '코스 생성 진행 상태와 입력 스냅샷을 저장한다. 입력 스냅샷에는 확정 추천 기준(걷는 속도, 이동 도움 필요 여부, 여행 취향, 음식 취향, 여행 대상)을 보관한다. 후보 코스 전체는 저장하지 않고, 완료 후 확정 일정만 trips/trip_days/trip_stops에 저장한다.'
}

Table course_generation_job_participants {
  id bigint [pk, increment]
  course_generation_job_id bigint [not null]
  parent_user_id bigint [not null]
  parent_profile_id bigint [not null]
  personality_result_id bigint
  created_at datetime [not null, default: `now()`]

  indexes {
    (course_generation_job_id, parent_user_id) [unique]
  }
}

Table course_generation_api_usages {
  id bigint [pk, increment]
  course_generation_job_id bigint [not null]
  provider external_api_provider [not null]
  purpose varchar(60) [not null]
  status varchar(30) [not null]
  request_hash varchar(64)
  result_count int
  duration_ms int
  error_message varchar(500)
  created_at datetime [not null, default: `now()`]

  indexes {
    (course_generation_job_id, provider)
    provider
  }
}

Table trip_days {
  id bigint [pk, increment]
  trip_id bigint [not null]
  day_number smallint [not null]
  travel_date date [not null]
  route_provider external_api_provider
  route_total_distance_m int
  route_total_duration_seconds int
  route_polyline jsonb
  route_source_payload jsonb
  route_optimized_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (trip_id, day_number) [unique]
  }

  Note: '현재 구현은 Tmap 경로 최적화 결과를 일자 단위 캐시로 저장한다. 코스 저장/추천 재생성/날짜 변경 시 route_* 값을 무효화한다.'
}

Table trip_stops {
  id bigint [pk, increment]
  trip_day_id bigint [not null]
  sort_order smallint [not null]
  stop_type stop_type [not null, default: 'sightseeing']
  source_provider external_api_provider [not null, default: 'tour_api']
  external_place_id varchar(120)
  content_type_id varchar(20)
  name varchar(120) [not null]
  category varchar(60)
  address varchar(255)
  latitude decimal(10,7)
  longitude decimal(10,7)
  phone varchar(30)
  homepage_url varchar(500)
  image_url varchar(500)
  overview text
  arrival_time time
  dwell_minutes smallint
  note varchar(255)
  recommendation_reason varchar(255)
  recommendation_tags jsonb
  source_payload jsonb
  is_manual_added boolean [not null, default: false]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (trip_day_id, sort_order) [unique]
  }

  Note: '현재 구현은 places 마스터 FK 없이 코스 저장 시 장소 스냅샷을 직접 저장한다. 후속 외부 API 연동 후 장소 캐시가 필요해지면 places와 연결한다.'
}

Table trip_daily_checklist_items {
  id bigint [pk, increment]
  trip_day_id bigint [not null]
  title varchar(80) [not null]
  description varchar(255)
  sort_order smallint [not null]
  is_completed boolean [not null, default: false]
  completed_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (trip_day_id, sort_order) [unique]
  }

  Note: 'PDF 여행 모드의 가족 체크리스트/마지막 날 체크리스트를 저장한다. 예: 체크인 완료, 약/소지품 확인, 귀가 교통편 확인, 여행 소감 남기기.'
}

Table trip_route_segments {
  id bigint [pk, increment]
  trip_day_id bigint [not null]
  from_trip_stop_id bigint [not null]
  to_trip_stop_id bigint [not null]
  provider external_api_provider [not null, default: 'tmap']
  transport_mode varchar(20)
  distance_m int
  duration_seconds int
  route_summary varchar(255)
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (from_trip_stop_id, to_trip_stop_id) [unique]
  }

  Note: '코스 순서, 장소, 날짜가 저장되면 Tmap 등 길찾기 API로 재계산해 갱신한다.'
}

// ---------- 5. 여행 10계명 ----------
Table pledge_templates {
  id bigint [pk, increment]
  content varchar(255) [not null]
  is_active boolean [not null, default: true]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table trip_pledges {
  id bigint [pk, increment]
  trip_id bigint [not null, unique]
  created_by_user_id bigint [not null]
  status trip_pledge_status [not null, default: 'draft']
  title varchar(80)
  rendered_image_url varchar(500)
  pdf_url varchar(500)
  reviewed_at datetime
  requested_at datetime
  completed_at datetime
  shared_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: 'PDF 확정 기준. 랜덤 후보 10개와 사용자 수정 내용은 내용 확인/서명 준비 단계에서 여행별 확정본으로 저장한다. status는 draft -> reviewed -> signature_requested -> completed로 진행한다. rendered_image_url은 현재 서명 상태까지 반영한 전체 10계명 비트맵, pdf_url은 자녀와 여행 참여 부모 최소 1명 서명 완료 후 생성한다.'
}

Table pledge_items {
  id bigint [pk, increment]
  trip_pledge_id bigint [not null]
  pledge_template_id bigint
  sort_order smallint [not null]
  content varchar(255) [not null]
  is_from_template boolean [not null, default: true]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (trip_pledge_id, sort_order) [unique]
  }
}

Table pledge_signatures {
  id bigint [pk, increment]
  trip_pledge_id bigint [not null]
  user_id bigint [not null]
  signature_image_url varchar(500)
  signed_at datetime
  created_at datetime [not null, default: `now()`]

  indexes {
    (trip_pledge_id, user_id) [unique]
  }
}

// ---------- 6. 피드백 · 효도 리포트 ----------
Table trip_feedback_requests {
  id bigint [pk, increment]
  trip_id bigint [not null]
  requested_by_user_id bigint [not null]
  parent_user_id bigint [not null]
  requested_at datetime [not null, default: `now()`]

  indexes {
    (trip_id, parent_user_id) [unique]
  }

  Note: '마지막날 자녀가 부모에게 별점 작성을 요청한 이력. 부모 작성 여부는 trip_feedbacks 존재 여부로 판단한다.'
}

Table trip_feedbacks {
  id bigint [pk, increment]
  trip_id bigint [not null]
  parent_user_id bigint [not null]
  overall_rating decimal(2,1)
  body_condition feedback_body_condition
  walk_rating smallint
  rest_rating smallint
  best_place_id bigint
  free_comment varchar(200)
  submitted_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (trip_id, parent_user_id) [unique]
  }

  Note: '여행 완료 후 부모가 작성하는 소감. overall_rating은 0.5 단위 0~5점으로 검증하고, 부모별 1회 제출한다.'
}

Table trip_feedback_tags {
  id bigint [pk, increment]
  trip_feedback_id bigint [not null]
  tag feedback_tag [not null]

  indexes {
    (trip_feedback_id, tag) [unique]
  }

  Note: '좋았던 점과 다음 여행 개선점을 feedback_tag ENUM으로 저장한다. 화면 분류와 추천 보정은 ENUM 매핑으로 처리한다.'
}

Table filial_reports {
  id bigint [pk, increment]
  trip_id bigint [not null, unique]
  total_score smallint
  satisfaction_score smallint
  leg_comfort_score smallint
  nagging_prevention_score smallint
  meal_satisfaction_score smallint
  restroom_safety_score smallint
  award_title varchar(80)
  summary varchar(255)
  cover_image_url varchar(500)
  best_place_id bigint
  best_comment varchar(500)
  parent_comment varchar(500)
  total_place_count smallint
  average_rating decimal(2,1)
  total_distance_km decimal(6,2)
  total_step_count int
  share_image_url varchar(500)
  generated_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  Note: '여행별 리포트 스냅샷. 함께 여행한 부모가 모두 trip_feedbacks를 제출한 뒤 생성하며, cover_image_url은 화면 대표 이미지, share_image_url은 공유용 렌더링 이미지다. 기록 탭 상단 통계는 family_id 기준 완료 여행과 filial_reports를 집계해서 계산한다.'
}

Table filial_report_stop_summaries {
  id bigint [pk, increment]
  filial_report_id bigint [not null]
  trip_stop_id bigint [not null]
  day_number smallint [not null]
  sort_order smallint [not null]
  place_name_snapshot varchar(120) [not null]
  badge report_stop_badge [not null]
  summary varchar(255) [not null]
  created_at datetime [not null, default: `now()`]

  indexes {
    (filial_report_id, trip_stop_id) [unique]
    (filial_report_id, day_number, sort_order) [unique]
  }

  Note: '기록 상세의 방문한 장소 흐름에 노출하는 장소별 리포트 요약. 편안/주의 배지와 한 줄 코멘트를 리포트 생성 시 스냅샷으로 저장한다.'
}

Table recommendation_adjustments {
  id bigint [pk, increment]
  parent_profile_id bigint [not null]
  trip_id bigint
  adjustment_code varchar(40) [not null]
  adjustment_value decimal(6,3) [not null]
  created_at datetime [not null, default: `now()`]
}

// ---------- 7. AI 챗봇 ----------
Table chat_sessions {
  id bigint [pk, increment]
  user_id bigint [not null]
  trip_id bigint
  context_place_id bigint
  scope chat_session_scope [not null, default: 'travel_mode']
  system_prompt_version varchar(30)
  model_name varchar(60)
  personalization_enabled boolean [not null, default: false]
  context_snapshot jsonb
  closed_at datetime
  created_at datetime [not null, default: `now()`]

  Note: '여행모드 AI 챗봇 세션. context_snapshot에는 현재 여행 코스, 선택 일자, 장소, 사용자 동의 시 부모 취향/MBTI 등 답변에 사용한 컨텍스트 스냅샷을 저장할 수 있다.'
}

Table chat_messages {
  id bigint [pk, increment]
  chat_session_id bigint [not null]
  sender chat_sender [not null]
  content text [not null]
  metadata jsonb
  created_at datetime [not null, default: `now()`]
}

// ---------- Relationships ----------
Ref: user_refresh_tokens.user_id > users.id

Ref: families.owner_user_id > users.id
Ref: family_members.family_id > families.id
Ref: family_members.user_id - users.id
Ref: family_codes.user_id - users.id
Ref: family_code_usages.family_code_id > family_codes.id
Ref: family_code_usages.requester_user_id > users.id
Ref: family_code_usages.family_id > families.id
Ref: parent_profiles.user_id - users.id
Ref: parent_profile_themes.parent_profile_id > parent_profiles.id
Ref: parent_personality_results.parent_profile_id > parent_profiles.id
Ref: parent_personality_results.travel_personality_type_id > travel_personality_types.id
Ref: parent_personality_scores.result_id > parent_personality_results.id

Ref: travel_destination_regions.travel_destination_id > travel_destinations.id
Ref: travel_destination_regions.region_id > regions.id
Ref: places.region_id > regions.id
Ref: place_external_refs.place_id > places.id
Ref: place_relations.source_place_id > places.id
Ref: place_relations.related_place_id > places.id
Ref: place_images.place_id > places.id
Ref: place_accessibility.place_id - places.id

Ref: trips.family_id > families.id
Ref: trips.created_by_user_id > users.id
Ref: trip_participants.trip_id > trips.id
Ref: trip_participants.user_id > users.id
Ref: course_generation_jobs.family_id > families.id
Ref: course_generation_jobs.requested_by_user_id > users.id
Ref: course_generation_jobs.trip_id - trips.id
Ref: course_generation_job_participants.course_generation_job_id > course_generation_jobs.id
Ref: course_generation_job_participants.parent_user_id > users.id
Ref: course_generation_job_participants.parent_profile_id > parent_profiles.id
Ref: course_generation_job_participants.personality_result_id > parent_personality_results.id
Ref: course_generation_api_usages.course_generation_job_id > course_generation_jobs.id
Ref: trip_days.trip_id > trips.id
Ref: trip_stops.trip_day_id > trip_days.id
Ref: trip_daily_checklist_items.trip_day_id > trip_days.id
Ref: trip_route_segments.trip_day_id > trip_days.id
Ref: trip_route_segments.from_trip_stop_id > trip_stops.id
Ref: trip_route_segments.to_trip_stop_id > trip_stops.id

Ref: trip_pledges.trip_id - trips.id
Ref: trip_pledges.created_by_user_id > users.id
Ref: pledge_items.trip_pledge_id > trip_pledges.id
Ref: pledge_items.pledge_template_id > pledge_templates.id
Ref: pledge_signatures.trip_pledge_id > trip_pledges.id
Ref: pledge_signatures.user_id > users.id

Ref: trip_feedback_requests.trip_id > trips.id
Ref: trip_feedback_requests.requested_by_user_id > users.id
Ref: trip_feedback_requests.parent_user_id > users.id
Ref: trip_feedbacks.trip_id > trips.id
Ref: trip_feedbacks.parent_user_id > users.id
Ref: trip_feedbacks.best_place_id > places.id
Ref: trip_feedback_tags.trip_feedback_id > trip_feedbacks.id
Ref: filial_reports.trip_id - trips.id
Ref: filial_reports.best_place_id > places.id
Ref: filial_report_stop_summaries.filial_report_id > filial_reports.id
Ref: filial_report_stop_summaries.trip_stop_id > trip_stops.id
Ref: recommendation_adjustments.parent_profile_id > parent_profiles.id
Ref: recommendation_adjustments.trip_id > trips.id

Ref: chat_sessions.user_id > users.id
Ref: chat_sessions.trip_id > trips.id
Ref: chat_sessions.context_place_id > places.id
Ref: chat_messages.chat_session_id > chat_sessions.id
