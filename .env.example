POSTGRES_DB=msdragon
POSTGRES_USER=msdragon
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432
SPRING_JPA_HIBERNATE_DDL_AUTO=update
APP_AUTH_JWT_SECRET=replace-with-openssl-rand-base64-48
APP_AUTH_ACCESS_TOKEN_EXPIRATION=P365D
APP_AUTH_APPLE_CLIENT_ID=com.msdragon.ios
# 탈퇴 시 애플 연결 해제(revoke)용. Apple Developer > Keys에서 발급한 Sign in with Apple 키.
APP_AUTH_APPLE_TEAM_ID=
APP_AUTH_APPLE_KEY_ID=
# .p8 파일 내용. PEM 헤더와 개행을 포함해도 되고 base64 한 줄로 넣어도 된다.
APP_AUTH_APPLE_PRIVATE_KEY=
# 탈퇴 시 카카오 연결 끊기용 어드민 키. 카카오 개발자센터 > 앱 키.
APP_AUTH_KAKAO_ADMIN_KEY=
APP_AUTH_OAUTH_REQUEST_TIMEOUT=PT5S
# 앱 스토어 심사용 가족 코드. 설정하면 심사자가 이 코드로 매번 새 데모 가족에 연결된다.
# 심사가 끝나면 값을 비우고 컨테이너를 재생성한다.
APP_REVIEW_FAMILY_CODE=
# 홈 추천 도시 이미지 URL에 붙는 서버 주소. 운영은 실제 도메인으로 설정한다.
APP_BASE_URL=https://api.ms-dragon.com
TOUR_API_SERVICE_KEY=
TOUR_API_MOBILE_APP=MSDragon
TOUR_API_CONNECT_TIMEOUT=PT5S
TOUR_API_REQUEST_TIMEOUT=PT10S
TMAP_APP_KEY=
TMAP_SEARCH_OPTION=0
TMAP_CAR_TYPE=1
TMAP_DEFAULT_START_TIME=10:00
TMAP_CONNECT_TIMEOUT=PT5S
TMAP_REQUEST_TIMEOUT=PT15S
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_CONNECT_TIMEOUT=PT5S
OPENAI_REQUEST_TIMEOUT=PT30S
OPENAI_MAX_OUTPUT_TOKENS=800
