// =====================================================================
// 모셔용(MoSheoYong) ERD - dbdiagram.io 용 DBML
// 로그인/회원가입 최소 구현 반영본
// - 온보딩 상태값 없음
// - 회원 여부는 users row 존재 여부로 판단
// - JWT refresh token 저장 테이블 추가
// - gender는 undisclosed 기본값
// =====================================================================

// ---------- Enums ----------
Enum user_role {
  child
  parent
}

Enum oauth_provider {
  kakao
  apple
}

Enum gender_type {
  female
  male
  undisclosed
}

Enum device_platform {
  ios
  android
  web
}

Enum invite_status {
  active
  used
  expired
}

Enum food_preference {
  korean_only
  open_minded
}

Enum mobility_aid_type {
  none
  cane
  walker
  wheelchair
}

Enum activity_level {
  slow
  moderate
  active
}

Enum trip_status {
  planning
  ready
  in_progress
  completed
  archived
}

Enum preference_weight {
  parent_only
  include_child
}

Enum trip_pace {
  relaxed
  moderate
  packed
}

Enum stop_type {
  sightseeing
  meal
  rest
  cafe
}

Enum chat_sender {
  user
  assistant
}

Enum consent_type {
  privacy
  location
  feedback_learning
}

Enum feedback_tag {
  walk_comfortable
  rest_enough
  food_satisfied
  restroom_easy
  quiet_good
  want_again
  time_with_family_good
  stairs_many
  walk_long
  rest_needed
  crowded
  cold
  long_car_ride
  next_indoor
}

// ---------- 1. 식별 · 인증 · 가족 ----------
Table users {
  id bigint [pk, increment]
  role user_role [not null]
  oauth_provider oauth_provider [not null]
  oauth_subject varchar(255) [not null]
  display_name varchar(50) [not null]
  age_band varchar(20) [not null, default: 'undisclosed']
  gender gender_type [not null, default: 'undisclosed']
  signup_completed_at datetime
  last_login_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
  deleted_at datetime

  indexes {
    (oauth_provider, oauth_subject) [unique]
  }
}

Table user_refresh_tokens {
  id bigint [pk, increment]
  user_id bigint [not null]
  refresh_token_hash varchar(255) [not null, unique]
  device_id varchar(100)
  platform device_platform
  issued_at datetime [not null, default: `now()`]
  expires_at datetime [not null]
  last_used_at datetime
  revoked_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    user_id
    expires_at
  }
}

Table families {
  id bigint [pk, increment]
  owner_user_id bigint [not null]
  is_active boolean [not null, default: true]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table family_members {
  id bigint [pk, increment]
  family_id bigint [not null]
  user_id bigint [not null, unique, note: '1유저 1가족']
  member_role user_role [not null]
  relation_label varchar(20)
  joined_at datetime [not null, default: `now()`]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table invite_codes {
  id bigint [pk, increment]
  family_id bigint [not null]
  code varchar(20) [not null, unique]
  status invite_status [not null, default: 'active']
  target_role user_role [not null, note: '이 코드를 입력할 수 있는 상대 역할']
  created_by_user_id bigint [not null]
  used_by_user_id bigint
  expires_at datetime
  used_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (family_id, status)
    (created_by_user_id, status)
  }
}

Table user_consents {
  id bigint [pk, increment]
  user_id bigint [not null]
  consent_type consent_type [not null]
  policy_version varchar(20) [not null, default: 'v1']
  agreed boolean [not null]
  agreed_at datetime [not null, default: `now()`]
  withdrawn_at datetime
  created_at datetime [not null, default: `now()`]

  indexes {
    (user_id, consent_type, policy_version) [unique]
  }
}

Table user_settings {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  schedule_share_noti boolean [not null, default: true]
  trip_day_noti boolean [not null, default: true]
  feedback_request_noti boolean [not null, default: true]
  location_permission boolean [not null, default: false]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

// ---------- 2. 부모 프로필 · 개인화 ----------
Table parent_profiles {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  fitness_level smallint [not null]
  activity_level activity_level [not null]
  food_preference food_preference [not null]
  avoid_spicy boolean [not null, default: false]
  mobility_aid mobility_aid_type [not null, default: 'none']
  completion_percent smallint [not null, default: 0]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table health_constraints {
  id bigint [pk, increment]
  code varchar(40) [not null, unique]
  label varchar(60) [not null]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table parent_profile_constraints {
  id bigint [pk, increment]
  parent_profile_id bigint [not null]
  health_constraint_id bigint [not null]

  indexes {
    (parent_profile_id, health_constraint_id) [unique]
  }
}

Table travel_themes {
  id bigint [pk, increment]
  code varchar(40) [not null, unique]
  label varchar(40) [not null]
  tour_api_category varchar(20)
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table parent_profile_themes {
  id bigint [pk, increment]
  parent_profile_id bigint [not null]
  travel_theme_id bigint [not null]

  indexes {
    (parent_profile_id, travel_theme_id) [unique]
  }
}

Table travel_personality_types {
  id bigint [pk, increment]
  type_code varchar(8) [not null, unique]
  name varchar(40) [not null]
  description text
  recommendation_principle text
  character_image_url varchar(500)
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table parent_personality_results {
  id bigint [pk, increment]
  parent_profile_id bigint [not null]
  travel_personality_type_id bigint [not null]
  is_current boolean [not null, default: true]
  created_at datetime [not null, default: `now()`]
}

Table parent_personality_scores {
  id bigint [pk, increment]
  result_id bigint [not null]
  metric_code varchar(40) [not null]
  score smallint [not null]

  indexes {
    (result_id, metric_code) [unique]
  }
}

// ---------- 3. 장소 · 접근성 ----------
Table regions {
  id bigint [pk, increment]
  area_code varchar(10) [unique]
  sido varchar(30) [not null]
  sigungu varchar(40)
  name varchar(60) [not null]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table places {
  id bigint [pk, increment]
  tour_api_content_id varchar(20) [unique]
  content_type_id varchar(10)
  region_id bigint
  name varchar(120) [not null]
  category varchar(40)
  address varchar(255)
  latitude decimal(10,7)
  longitude decimal(10,7)
  phone varchar(30)
  homepage_url varchar(500)
  image_url varchar(500)
  operating_hours varchar(255)
  admission_fee varchar(100)
  overview text
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table place_accessibility {
  id bigint [pk, increment]
  place_id bigint [not null, unique]
  has_stairs boolean
  has_slope boolean
  is_indoor boolean
  has_elevator boolean
  has_seating boolean
  wheelchair_accessible boolean
  restroom_distance_m int
  accessibility_score smallint
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

// ---------- 4. 여행 · 일정 ----------
Table trips {
  id bigint [pk, increment]
  family_id bigint [not null]
  created_by_user_id bigint [not null]
  region_id bigint [not null, note: '생성 후 immutable']
  title varchar(80) [not null]
  start_date date [not null]
  end_date date [not null]
  status trip_status [not null, default: 'planning']
  preference_weight preference_weight [not null, default: 'parent_only']
  pace trip_pace [not null, default: 'relaxed']
  comfort_score smallint
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
  deleted_at datetime
}

Table trip_participants {
  id bigint [pk, increment]
  trip_id bigint [not null]
  user_id bigint [not null]
  created_at datetime [not null, default: `now()`]

  indexes {
    (trip_id, user_id) [unique]
  }
}

Table trip_days {
  id bigint [pk, increment]
  trip_id bigint [not null]
  day_number smallint [not null]
  travel_date date [not null]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (trip_id, day_number) [unique]
  }
}

Table trip_stops {
  id bigint [pk, increment]
  trip_day_id bigint [not null]
  place_id bigint [not null]
  sort_order smallint [not null]
  stop_type stop_type [not null, default: 'sightseeing']
  arrival_time time
  dwell_minutes smallint
  note varchar(255)
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

// ---------- 5. 여행 10계명 ----------
Table trip_pledges {
  id bigint [pk, increment]
  trip_id bigint [not null, unique]
  title varchar(80)
  signature_image_url varchar(500)
  shared_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table pledge_items {
  id bigint [pk, increment]
  trip_pledge_id bigint [not null]
  sort_order smallint [not null]
  content varchar(255) [not null]
  is_from_template boolean [not null, default: true]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table pledge_signatures {
  id bigint [pk, increment]
  trip_pledge_id bigint [not null]
  user_id bigint [not null]
  signature_image_url varchar(500)
  signed_at datetime
  created_at datetime [not null, default: `now()`]

  indexes {
    (trip_pledge_id, user_id) [unique]
  }
}

// ---------- 6. 피드백 · 효도 리포트 ----------
Table trip_feedbacks {
  id bigint [pk, increment]
  trip_id bigint [not null]
  parent_user_id bigint [not null]
  overall_rating decimal(2,1)
  walk_rating smallint
  rest_rating smallint
  free_comment varchar(500)
  submitted_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (trip_id, parent_user_id) [unique]
  }
}

Table trip_feedback_tags {
  id bigint [pk, increment]
  trip_feedback_id bigint [not null]
  tag feedback_tag [not null]

  indexes {
    (trip_feedback_id, tag) [unique]
  }
}

Table filial_reports {
  id bigint [pk, increment]
  trip_id bigint [not null, unique]
  total_score smallint
  satisfaction_score smallint
  rest_interval_score smallint
  walk_burden_score smallint
  summary varchar(255)
  best_place_id bigint
  parent_comment varchar(500)
  generated_at datetime
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table recommendation_adjustments {
  id bigint [pk, increment]
  parent_profile_id bigint [not null]
  trip_id bigint
  adjustment_code varchar(40) [not null]
  adjustment_value decimal(6,3) [not null]
  created_at datetime [not null, default: `now()`]
}

// ---------- 7. AI 챗봇 ----------
Table chat_sessions {
  id bigint [pk, increment]
  user_id bigint [not null]
  trip_id bigint
  context_place_id bigint
  created_at datetime [not null, default: `now()`]
}

Table chat_messages {
  id bigint [pk, increment]
  chat_session_id bigint [not null]
  sender chat_sender [not null]
  content text [not null]
  created_at datetime [not null, default: `now()`]
}

// ---------- Relationships ----------
Ref: user_refresh_tokens.user_id > users.id

Ref: families.owner_user_id > users.id
Ref: family_members.family_id > families.id
Ref: family_members.user_id - users.id
Ref: invite_codes.family_id > families.id
Ref: invite_codes.created_by_user_id > users.id
Ref: invite_codes.used_by_user_id > users.id
Ref: user_consents.user_id > users.id
Ref: user_settings.user_id - users.id

Ref: parent_profiles.user_id - users.id
Ref: parent_profile_constraints.parent_profile_id > parent_profiles.id
Ref: parent_profile_constraints.health_constraint_id > health_constraints.id
Ref: parent_profile_themes.parent_profile_id > parent_profiles.id
Ref: parent_profile_themes.travel_theme_id > travel_themes.id
Ref: parent_personality_results.parent_profile_id > parent_profiles.id
Ref: parent_personality_results.travel_personality_type_id > travel_personality_types.id
Ref: parent_personality_scores.result_id > parent_personality_results.id

Ref: places.region_id > regions.id
Ref: place_accessibility.place_id - places.id

Ref: trips.family_id > families.id
Ref: trips.created_by_user_id > users.id
Ref: trips.region_id > regions.id
Ref: trip_participants.trip_id > trips.id
Ref: trip_participants.user_id > users.id
Ref: trip_days.trip_id > trips.id
Ref: trip_stops.trip_day_id > trip_days.id
Ref: trip_stops.place_id > places.id

Ref: trip_pledges.trip_id - trips.id
Ref: pledge_items.trip_pledge_id > trip_pledges.id
Ref: pledge_signatures.trip_pledge_id > trip_pledges.id
Ref: pledge_signatures.user_id > users.id

Ref: trip_feedbacks.trip_id > trips.id
Ref: trip_feedbacks.parent_user_id > users.id
Ref: trip_feedback_tags.trip_feedback_id > trip_feedbacks.id
Ref: filial_reports.trip_id - trips.id
Ref: filial_reports.best_place_id > places.id
Ref: recommendation_adjustments.parent_profile_id > parent_profiles.id
Ref: recommendation_adjustments.trip_id > trips.id

Ref: chat_sessions.user_id > users.id
Ref: chat_sessions.trip_id > trips.id
Ref: chat_sessions.context_place_id > places.id
Ref: chat_messages.chat_session_id > chat_sessions.id